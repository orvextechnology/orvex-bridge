
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080d20">
<title>My Profile | ORVEX BRIDGE</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #080d20;
    color: #f5f7ff;
    line-height: 1.6;
}

header {
    background: #101a35;
    padding: 18px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    border-bottom: 1px solid #263657;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: #d8b45c;
}

nav a {
    color: #dce4f7;
    text-decoration: none;
    margin-left: 13px;
    font-size: 14px;
}

nav a:hover {
    color: #e4bd69;
}

.container {
    width: 90%;
    max-width: 950px;
    margin: 35px auto;
}

.heading {
    margin-bottom: 25px;
}

.heading h1 {
    font-size: 29px;
}

.heading p {
    color: #aebbd3;
    font-size: 14px;
}

.profile-card {
    background: #111d38;
    border: 1px solid #2a3c5d;
    border-radius: 14px;
    padding: 25px;
    margin-bottom: 22px;
}

.profile-top {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 25px;
}

.avatar {
    width: 75px;
    height: 75px;
    background: #d8b45c;
    color: #10172a;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 30px;
    font-weight: bold;
}

.profile-top h2 {
    font-size: 20px;
}

.profile-top p {
    color: #aebbd3;
    font-size: 13px;
}

.status {
    display: inline-block;
    background: #263958;
    color: #e4c475;
    padding: 5px 11px;
    border-radius: 20px;
    font-size: 11px;
    margin-top: 7px;
}

.section-title {
    font-size: 19px;
    margin-bottom: 18px;
    color: #e2bd69;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 17px;
}

.field {
    margin-bottom: 4px;
}

.field label {
    display: block;
    margin-bottom: 7px;
    font-size: 13px;
    color: #c6d1e5;
}

.field input,
.field select {
    width: 100%;
    padding: 13px;
    background: #0b142b;
    color: white;
    border: 1px solid #344766;
    border-radius: 7px;
    outline: none;
}

.field input:focus,
.field select:focus {
    border-color: #d8b45c;
}

.field input:disabled,
.field select:disabled {
    opacity: 0.7;
}

button {
    border: none;
    padding: 12px 20px;
    border-radius: 7px;
    font-weight: bold;
    cursor: pointer;
}

.primary {
    background: #d8b45c;
    color: #10172a;
}

.secondary {
    background: #293b5b;
    color: white;
    margin-left: 8px;
}

.buttons {
    margin-top: 22px;
}

.progress {
    background: #293b5b;
    height: 9px;
    border-radius: 20px;
    overflow: hidden;
    margin: 13px 0;
}

.progress-bar {
    height: 100%;
    width: 0%;
    background: #d8b45c;
    transition: width 0.3s;
}

.profile-note {
    color: #aebbd3;
    font-size: 13px;
}

.info-row {
    padding: 13px 0;
    border-bottom: 1px solid #293b5b;
    display: flex;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
}

.info-row:last-child {
    border-bottom: none;
}

.info-row span:last-child {
    color: #e2bd69;
    text-align: right;
}

footer {
    background: #101a35;
    text-align: center;
    padding: 28px 15px;
    margin-top: 50px;
    color: #9daac2;
    font-size: 13px;
}

footer a {
    color: #e2bd69;
    text-decoration: none;
}

@media(max-width:600px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .heading h1 {
        font-size: 25px;
    }

    nav a {
        font-size: 12px;
        margin-left: 7px;
    }

    .profile-top {
        align-items: flex-start;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">ORVEX BRIDGE</div>

    <nav>
        <a href="index.html">Home</a>
        <a href="dashboard.html">Dashboard</a>
        <a href="earn.html">Earn</a>
        <a href="invest.html">Invest</a>
    </nav>
</header>

<main class="container">

    <div class="heading">
        <h1>My Profile</h1>
        <p>Manage your personal information and account details.</p>
    </div>

    <section class="profile-card">

        <div class="profile-top">
            <div class="avatar" id="avatar">U</div>

            <div>
                <h2 id="displayName">ORVEX Member</h2>
                <p id="displayEmail">Account email not connected</p>
                <span class="status">Preview Account</span>
            </div>
        </div>

        <h3 class="section-title">Personal Information</h3>

        <form id="profileForm">

            <div class="form-grid">

                <div class="field">
                    <label for="fullName">Full Name</label>
                    <input type="text" id="fullName"
                        placeholder="Enter your full name" required>
                </div>

                <div class="field">
                    <label for="email">Email Address</label>
                    <input type="email" id="email"
                        placeholder="Enter your email" required>
                </div>

                <div class="field">
                    <label for="country">Country</label>
                    <input type="text" id="country"
                        placeholder="Enter your country">
                </div>

                <div class="field">
                    <label for="accountType">Account Type</label>
                    <select id="accountType">
                        <option value="Individual">Individual</option>
                        <option value="Business">Business</option>
                    </select>
                </div>

                <div class="field">
                    <label for="phone">Phone Number</label>
                    <input type="tel" id="phone"
                        placeholder="Enter phone number">
                </div>

                <div class="field">
                    <label for="profession">Profession / Skills</label>
                    <input type="text" id="profession"
                        placeholder="e.g. Graphic Designer">
                </div>

            </div>

            <div class="buttons">
                <button type="button" class="primary" id="editButton">
                    Edit Profile
                </button>

                <button type="submit" class="primary"
                    id="saveButton" hidden>
                    Save Changes
                </button>

                <button type="button" class="secondary"
                    id="cancelButton" hidden>
                    Cancel
                </button>
            </div>

        </form>

    </section>

    <section class="profile-card">

        <h3 class="section-title">Profile Completion</h3>

        <div id="completionText">0% completed</div>

        <div class="progress">
            <div class="progress-bar" id="progressBar"></div>
        </div>

        <p class="profile-note">
            Complete your profile information to prepare for future
            ORVEX BRIDGE account features.
        </p>

    </section>

    <section class="profile-card">

        <h3 class="section-title">Account Information</h3>

        <div class="info-row">
            <span>Platform</span>
            <span>ORVEX BRIDGE</span>
        </div>

        <div class="info-row">
            <span>Account Status</span>
            <span>Preview Only</span>
        </div>

        <div class="info-row">
            <span>Authentication</span>
            <span>Not Connected</span>
        </div>

        <div class="info-row">
            <span>Wallet</span>
            <span>Not Connected</span>
        </div>

    </section>

    <section class="profile-card">

        <h3 class="section-title">Account Security</h3>

        <p class="profile-note">
            Secure account login, password management, email verification
            and two-factor authentication will be introduced when the
            ORVEX backend is connected.
        </p>

    </section>

</main>

<footer>
    <p>© 2026 ORVEX BRIDGE. All Rights Reserved.</p>
    <p>Connecting Global Businesses with Emerging Talent.</p>
    <p><a href="dashboard.html">Return to Dashboard</a></p>
</footer>

<script>
const form = document.getElementById("profileForm");
const editButton = document.getElementById("editButton");
const saveButton = document.getElementById("saveButton");
const cancelButton = document.getElementById("cancelButton");

const fields = [
    "fullName",
    "email",
    "country",
    "accountType",
    "phone",
    "profession"
];

let originalData = {};

function getData() {
    const data = {};

    fields.forEach(id => {
        data[id] = document.getElementById(id).value;
    });

    return data;
}

function updateProfileDisplay() {
    const name = document.getElementById("fullName").value.trim();
    const email = document.getElementById("email").value.trim();

    document.getElementById("displayName").textContent =
        name || "ORVEX Member";

    document.getElementById("displayEmail").textContent =
        email || "Account email not connected";

    document.getElementById("avatar").textContent =
        name ? name.charAt(0).toUpperCase() : "U";

    const completed = fields.filter(id =>
        document.getElementById(id).value.trim() !== ""
    ).length;

    const percentage = Math.round((completed / fields.length) * 100);

    document.getElementById("completionText").textContent =
        percentage + "% completed";

    document.getElementById("progressBar").style.width =
        percentage + "%";
}

function setEditing(enabled) {
    fields.forEach(id => {
        document.getElementById(id).disabled = !enabled;
    });

    editButton.hidden = enabled;
    saveButton.hidden = !enabled;
    cancelButton.hidden = !enabled;
}

function loadProfile() {
    try {
        const saved = localStorage.getItem("orvexProfile");

        if (saved) {
            const data = JSON.parse(saved);

            fields.forEach(id => {
                document.getElementById(id).value = data[id] || "";
            });
        }
    } catch (error) {
        console.log("Profile could not be loaded.");
    }

    updateProfileDisplay();
    setEditing(false);
}

editButton.addEventListener("click", function() {
    originalData = getData();
    setEditing(true);
});

cancelButton.addEventListener("click", function() {
    fields.forEach(id => {
        document.getElementById(id).value = originalData[id] || "";
    });

    updateProfileDisplay();
    setEditing(false);
});

form.addEventListener("submit", function(event) {
    event.preventDefault();

    if (!form.reportValidity()) return;

    const data = getData();

    try {
        localStorage.setItem("orvexProfile", JSON.stringify(data));

        updateProfileDisplay();
        setEditing(false);

        alert(
            "Profile saved on this device. " +
            "It is not yet connected to a secure ORVEX account."
        );

    } catch (error) {
        alert("Unable to save profile on this device.");
    }
});

loadProfile();
</script>

</body>
</html>
